#version 450
layout(local_size_x = 32) in;
layout(binding = 0) uniform sampler2D tex_a;   // plain sampler type, sampler object has compareEnable
layout(binding = 1) uniform sampler2D tex_b;
layout(std430, binding = 2) buffer Out { float res[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	res[i]       = textureLod(tex_a, vec2(0.5, 0.5), 0.0).r;
	res[i + 32u] = textureLod(tex_a, vec2(1.5, 0.5), 0.0).r;
	res[i + 64u] = textureLod(tex_b, vec2(1.5, 0.5), 0.0).r;
}
